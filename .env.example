# Cloud Odyssey production server environment
# DO NOT commit real secrets. Copy names into Vercel Project Settings -> Environment Variables.

# Neon Postgres pooled/serverless connection string
DATABASE_URL=

# Managed Better Auth base URL from Neon Console -> Project -> Branch -> Auth -> Configuration.
# Example shape only:
# https://ep-xxxx.neonauth.us-east-2.aws.neon.build/neondb/auth
NEON_AUTH_BASE_URL=

# Optional explicit overrides. Cloud Odyssey derives these from NEON_AUTH_BASE_URL by default.
# NEON_AUTH_JWKS_URL=
# AUTH_ISSUER=
# AUTH_AUDIENCE=

# Keep false until sign-up/sign-in/JWT verification/cross-device restore are proven in production.
AUTH_REQUIRED=false

# Generate outside source control, e.g. openssl rand -hex 32
ASSESSMENT_SIGNING_SECRET=
